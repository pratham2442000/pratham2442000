{
  "$defs": {
    "CandidateBackground": {
      "description": "Complete candidate background extracted from CV/resume and portfolio.",
      "properties": {
        "personal_info": {
          "$ref": "#/$defs/PersonalInfo"
        },
        "education": {
          "items": {
            "$ref": "#/$defs/EducationEntry"
          },
          "title": "Education",
          "type": "array"
        },
        "verified_technical_skills": {
          "items": {
            "$ref": "#/$defs/SkillCategory"
          },
          "title": "Verified Technical Skills",
          "type": "array"
        },
        "experience_summaries": {
          "items": {
            "$ref": "#/$defs/ExperienceEntry"
          },
          "title": "Experience Summaries",
          "type": "array"
        },
        "project_highlights": {
          "items": {
            "$ref": "#/$defs/ProjectEntry"
          },
          "title": "Project Highlights",
          "type": "array"
        },
        "infrastructure_and_homelab": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/InfrastructureEntry"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Infrastructure And Homelab"
        }
      },
      "required": [
        "personal_info"
      ],
      "title": "CandidateBackground",
      "type": "object"
    },
    "CandidatePreferences": {
      "description": "Unified candidate preferences and hard constraints.",
      "properties": {
        "target_roles": {
          "items": {
            "$ref": "#/$defs/TargetRole"
          },
          "title": "Target Roles",
          "type": "array"
        },
        "seniority": {
          "$ref": "#/$defs/SeniorityPreferences"
        },
        "locations": {
          "$ref": "#/$defs/LocationPreferences"
        },
        "sponsorship": {
          "$ref": "#/$defs/SponsorshipPreferences"
        },
        "work_setup": {
          "$ref": "#/$defs/WorkSetupPreferences"
        }
      },
      "title": "CandidatePreferences",
      "type": "object"
    },
    "CompanyTierItem": {
      "description": "Company specification within a preference tier.",
      "properties": {
        "name": {
          "description": "Clean company name",
          "title": "Name",
          "type": "string"
        },
        "keyword": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lookup keyword or identifier",
          "title": "Keyword"
        },
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Primary company website domain",
          "title": "Domain"
        },
        "careers_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Direct careers or jobs portal URL",
          "title": "Careers Url"
        },
        "ats_slug": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ATS slug (for Greenhouse, Lever, etc.)",
          "title": "Ats Slug"
        },
        "ats_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ATS platform name",
          "title": "Ats Type"
        },
        "multiplier": {
          "default": 1.0,
          "description": "Match score multiplier",
          "maximum": 5.0,
          "minimum": 0.0,
          "title": "Multiplier",
          "type": "number"
        },
        "bonus_points": {
          "default": 0.0,
          "description": "Flat bonus points added for this company",
          "title": "Bonus Points",
          "type": "number"
        },
        "tier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "Curated Sponsor",
          "description": "Tier category",
          "title": "Tier"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why this company is in this tier",
          "title": "Reason"
        }
      },
      "required": [
        "name"
      ],
      "title": "CompanyTierItem",
      "type": "object"
    },
    "CompanyTiers": {
      "description": "Ranked company tier lists.",
      "properties": {
        "tier_1_dream": {
          "description": "Tier 1 dream companies (highest priority)",
          "items": {
            "$ref": "#/$defs/CompanyTierItem"
          },
          "title": "Tier 1 Dream",
          "type": "array"
        },
        "tier_2_high_priority": {
          "description": "Tier 2 high-priority companies",
          "items": {
            "$ref": "#/$defs/CompanyTierItem"
          },
          "title": "Tier 2 High Priority",
          "type": "array"
        },
        "tier_3_neutral": {
          "description": "Tier 3 acceptable / standard companies",
          "items": {
            "$ref": "#/$defs/CompanyTierItem"
          },
          "title": "Tier 3 Neutral",
          "type": "array"
        },
        "curated_sponsors": {
          "description": "Comprehensive catalog of curated sponsor endpoints across all ATS platforms",
          "items": {
            "$ref": "#/$defs/CompanyTierItem"
          },
          "title": "Curated Sponsors",
          "type": "array"
        },
        "excluded_companies": {
          "description": "Company names or patterns to strictly ignore / blacklist",
          "items": {
            "type": "string"
          },
          "title": "Excluded Companies",
          "type": "array"
        }
      },
      "title": "CompanyTiers",
      "type": "object"
    },
    "CompensationPreference": {
      "description": "Salary and compensation expectations.",
      "properties": {
        "minimum_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum acceptable base salary",
          "title": "Minimum Amount"
        },
        "target_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Target base salary",
          "title": "Target Amount"
        },
        "currency": {
          "default": "EUR",
          "description": "ISO 4217 Currency code (EUR, USD, GBP, etc.)",
          "title": "Currency",
          "type": "string"
        },
        "period": {
          "default": "yearly",
          "description": "Compensation period: yearly, monthly, hourly",
          "title": "Period",
          "type": "string"
        }
      },
      "title": "CompensationPreference",
      "type": "object"
    },
    "ComponentWeights": {
      "description": "Relative importance weights for major scoring dimensions (should sum close to 1.0).",
      "properties": {
        "role_title_match": {
          "default": 0.35,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Role Title Match",
          "type": "number"
        },
        "skills_match": {
          "default": 0.3,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Skills Match",
          "type": "number"
        },
        "location_match": {
          "default": 0.2,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Location Match",
          "type": "number"
        },
        "company_and_domain": {
          "default": 0.15,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Company And Domain",
          "type": "number"
        }
      },
      "title": "ComponentWeights",
      "type": "object"
    },
    "CoverLetterTemplate": {
      "description": "A personalized cover letter body template matched dynamically to jobs.",
      "properties": {
        "template_id": {
          "description": "Unique slug (e.g. 'formula1_motorsport')",
          "title": "Template Id",
          "type": "string"
        },
        "title": {
          "description": "Display title (e.g. '10. FORMULA 1 & MOTORSPORT')",
          "title": "Title",
          "type": "string"
        },
        "priority": {
          "default": 50,
          "description": "Evaluation priority (higher checked first)",
          "title": "Priority",
          "type": "integer"
        },
        "trigger_patterns": {
          "description": "Regex patterns in job title or description that trigger this recommendation",
          "items": {
            "type": "string"
          },
          "title": "Trigger Patterns",
          "type": "array"
        },
        "letter_file_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path or anchor in letter_bodies.tex or templates directory",
          "title": "Letter File Reference"
        },
        "body_snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Raw text or LaTeX snippet of the cover letter core body",
          "title": "Body Snippet"
        },
        "talking_points": {
          "description": "Key candidate projects/experiences to highlight in this letter",
          "items": {
            "type": "string"
          },
          "title": "Talking Points",
          "type": "array"
        }
      },
      "required": [
        "template_id",
        "title"
      ],
      "title": "CoverLetterTemplate",
      "type": "object"
    },
    "DomainItem": {
      "description": "Industry sector or technical domain.",
      "properties": {
        "name": {
          "description": "Domain name (e.g. Autonomous Vehicles, FinTech, Foundation Models)",
          "title": "Name",
          "type": "string"
        },
        "weight": {
          "default": 10.0,
          "description": "Score impact (positive bonus or negative penalty)",
          "title": "Weight",
          "type": "number"
        },
        "patterns": {
          "description": "Regex patterns identifying this domain",
          "items": {
            "type": "string"
          },
          "title": "Patterns",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "DomainItem",
      "type": "object"
    },
    "EducationEntry": {
      "description": "Educational degree or qualification.",
      "properties": {
        "institution": {
          "description": "University, college, or school name",
          "title": "Institution",
          "type": "string"
        },
        "degree": {
          "description": "Degree type (e.g. MSc, BSc, PhD, BootCamp)",
          "title": "Degree",
          "type": "string"
        },
        "field_of_study": {
          "description": "Major or area of specialization",
          "title": "Field Of Study",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "City, Country of institution",
          "title": "Location"
        },
        "start_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Start date (YYYY-MM or Year)",
          "title": "Start Date"
        },
        "end_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End or graduation date (YYYY-MM or Year)",
          "title": "End Date"
        },
        "gpa": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "GPA or grade classification if relevant",
          "title": "Gpa"
        },
        "thesis_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Master's or doctoral thesis title",
          "title": "Thesis Title"
        },
        "thesis_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Public repository or DOI URL for thesis",
          "title": "Thesis Url"
        },
        "thesis_abstract": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Brief summary of thesis research",
          "title": "Thesis Abstract"
        },
        "highlights": {
          "description": "Key courses, awards, or distinctions",
          "items": {
            "type": "string"
          },
          "title": "Highlights",
          "type": "array"
        }
      },
      "required": [
        "institution",
        "degree",
        "field_of_study"
      ],
      "title": "EducationEntry",
      "type": "object"
    },
    "EvaluationAndScoringRubric": {
      "description": "Custom weights, thresholds, penalties, and cover letter mapping rules.",
      "properties": {
        "base_score": {
          "default": 15.0,
          "description": "Baseline starting score for any evaluated job",
          "maximum": 50.0,
          "minimum": 0.0,
          "title": "Base Score",
          "type": "number"
        },
        "min_match_threshold": {
          "default": 40.0,
          "description": "Minimum score to be considered a match",
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Min Match Threshold",
          "type": "number"
        },
        "max_score": {
          "default": 99.0,
          "description": "Ceiling cap for match scores",
          "maximum": 100.0,
          "minimum": 50.0,
          "title": "Max Score",
          "type": "number"
        },
        "component_weights": {
          "$ref": "#/$defs/ComponentWeights"
        },
        "enable_company_multipliers": {
          "default": false,
          "description": "Whether to apply employer tier multipliers and bonuses",
          "title": "Enable Company Multipliers",
          "type": "boolean"
        },
        "enable_domain_bonuses": {
          "default": false,
          "description": "Whether to award additional industry domain bonuses",
          "title": "Enable Domain Bonuses",
          "type": "boolean"
        },
        "penalties": {
          "items": {
            "$ref": "#/$defs/PenaltyItem"
          },
          "title": "Penalties",
          "type": "array"
        },
        "cover_letter_templates": {
          "items": {
            "$ref": "#/$defs/CoverLetterTemplate"
          },
          "title": "Cover Letter Templates",
          "type": "array"
        },
        "default_cover_letter": {
          "default": "1. GENERIC / OPEN APPLICATION",
          "description": "Fallback cover letter when no specialized trigger matches",
          "title": "Default Cover Letter",
          "type": "string"
        }
      },
      "title": "EvaluationAndScoringRubric",
      "type": "object"
    },
    "ExperienceEntry": {
      "description": "Work, internship, or research experience.",
      "properties": {
        "company": {
          "description": "Employer or organization name",
          "title": "Company",
          "type": "string"
        },
        "title": {
          "description": "Job title held",
          "title": "Title",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Location of work",
          "title": "Location"
        },
        "start_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Start date (YYYY-MM or Year)",
          "title": "Start Date"
        },
        "end_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End date (YYYY-MM or 'Present')",
          "title": "End Date"
        },
        "is_current": {
          "default": false,
          "description": "Whether the candidate currently works here",
          "title": "Is Current",
          "type": "boolean"
        },
        "role_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "full-time",
          "description": "Type of role: full-time, part-time, internship, research, contractor",
          "title": "Role Type"
        },
        "technologies": {
          "description": "Tech stack utilized in this role",
          "items": {
            "type": "string"
          },
          "title": "Technologies",
          "type": "array"
        },
        "key_achievements": {
          "description": "Bullet points describing concrete achievements and metrics",
          "items": {
            "type": "string"
          },
          "title": "Key Achievements",
          "type": "array"
        }
      },
      "required": [
        "company",
        "title"
      ],
      "title": "ExperienceEntry",
      "type": "object"
    },
    "IndustryPreferences": {
      "description": "Preferred and anti-pattern industry domains.",
      "properties": {
        "preferred_domains": {
          "items": {
            "$ref": "#/$defs/DomainItem"
          },
          "title": "Preferred Domains",
          "type": "array"
        },
        "excluded_domains": {
          "items": {
            "$ref": "#/$defs/DomainItem"
          },
          "title": "Excluded Domains",
          "type": "array"
        }
      },
      "title": "IndustryPreferences",
      "type": "object"
    },
    "InfrastructureEntry": {
      "description": "Hands-on homelab, self-hosting, or infrastructure highlights.",
      "properties": {
        "title": {
          "description": "Infrastructure component (e.g. Bare-Metal Server, Mesh VPN)",
          "title": "Title",
          "type": "string"
        },
        "description": {
          "description": "Technical implementation details",
          "title": "Description",
          "type": "string"
        },
        "tools": {
          "description": "Tools/services (e.g. Docker, Tailscale, Pi-hole)",
          "items": {
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "required": [
        "title",
        "description"
      ],
      "title": "InfrastructureEntry",
      "type": "object"
    },
    "LocationPreferences": {
      "description": "Geographic preferences, regional tiers, and explicit exclusions.",
      "properties": {
        "tiers": {
          "description": "Ordered location preference tiers",
          "items": {
            "$ref": "#/$defs/LocationTier"
          },
          "title": "Tiers",
          "type": "array"
        },
        "remote": {
          "$ref": "#/$defs/RemotePreference"
        },
        "us_target_hubs": {
          "description": "Specific US metro areas accepted even if broader US is excluded",
          "items": {
            "type": "string"
          },
          "title": "Us Target Hubs",
          "type": "array"
        },
        "us_hub_patterns": {
          "description": "Regex patterns identifying target US metropolitan hubs",
          "items": {
            "type": "string"
          },
          "title": "Us Hub Patterns",
          "type": "array"
        },
        "excluded_locations": {
          "description": "Regex patterns of regions to filter out unless explicitly remote or in target hubs",
          "items": {
            "type": "string"
          },
          "title": "Excluded Locations",
          "type": "array"
        }
      },
      "title": "LocationPreferences",
      "type": "object"
    },
    "LocationTier": {
      "description": "A geographic target tier with associated bonus points and matching regex patterns.",
      "properties": {
        "name": {
          "description": "Tier or region name (e.g. Netherlands, United Kingdom, US Tech Hubs)",
          "title": "Name",
          "type": "string"
        },
        "weight": {
          "default": 20.0,
          "description": "Bonus points for matching this location",
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Weight",
          "type": "number"
        },
        "patterns": {
          "description": "Regex patterns matching cities/countries in this tier",
          "items": {
            "type": "string"
          },
          "title": "Patterns",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "LocationTier",
      "type": "object"
    },
    "OutputSettings": {
      "description": "Customizable paths and reporting options.",
      "properties": {
        "reports_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Directory where reports are saved",
          "title": "Reports Dir"
        },
        "markdown_filename": {
          "default": "recommended_jobs.md",
          "description": "Markdown report filename",
          "title": "Markdown Filename",
          "type": "string"
        },
        "json_filename": {
          "default": "recommended_jobs.json",
          "description": "JSON export filename",
          "title": "Json Filename",
          "type": "string"
        },
        "sqlite_db_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "v2/data/sponsors.db",
          "description": "Custom SQLite database path",
          "title": "Sqlite Db Path"
        }
      },
      "title": "OutputSettings",
      "type": "object"
    },
    "PenaltyItem": {
      "description": "A deduction rule applied when specific anti-patterns are found.",
      "properties": {
        "name": {
          "description": "Penalty name (e.g. Non-technical, Frontend, Sales)",
          "title": "Name",
          "type": "string"
        },
        "deduction": {
          "description": "Points to subtract (negative value or positive deduction amount)",
          "title": "Deduction",
          "type": "number"
        },
        "pattern": {
          "description": "Regex pattern triggering this penalty",
          "title": "Pattern",
          "type": "string"
        },
        "reason": {
          "description": "Explanation displayed in match rationale",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "name",
        "deduction",
        "pattern",
        "reason"
      ],
      "title": "PenaltyItem",
      "type": "object"
    },
    "PersonalInfo": {
      "description": "Personal and contact information for the candidate.",
      "properties": {
        "name": {
          "description": "Full legal or professional name of the candidate",
          "title": "Name",
          "type": "string"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Contact email address",
          "title": "Email"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Contact phone number (optional)",
          "title": "Phone"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Current physical residence (City, Country)",
          "title": "Location"
        },
        "linkedin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Full LinkedIn profile URL",
          "title": "Linkedin"
        },
        "github": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Full GitHub profile URL",
          "title": "Github"
        },
